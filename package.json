{
  "name": "paj-captain",
  "version": "0.1.0",
  "description": "Text-first coordination of main Paj agents inside Pi",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jlodenius/paj-captain.git" },
  "homepage": "https://github.com/jlodenius/paj-captain",
  "engines": { "node": ">=24" },
  "keywords": ["pi-package", "paj"],
  "files": ["dist", "skills", "examples", "docs", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "typebox": "*" },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "pi": { "extensions": ["dist/extensions"], "skills": ["skills"] }
}
